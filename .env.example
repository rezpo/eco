# Eco Sidekick - API Keys Configuration
# Copy this file as .env (or ~/.eco.env) and configure your API keys

# Deepgram (required for real-time transcription)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT-4)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# MiMo (OpenAI-compatible API)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5-chat
