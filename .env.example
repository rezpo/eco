# Eco Sidekick - Configuración de API Keys
# Copia este archivo como .env y configura tus API keys

# Deepgram (requerido para transcripción en tiempo real)
# Obtén tu key en: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic (Claude)
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT-4)
# Obtén tu key en: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# MiMo (API compatible con OpenAI)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5-chat
